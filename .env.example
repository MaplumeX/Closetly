# 复制为 .env 后修改

# 使用的镜像版本，例如 0.1.0；不设置则使用 latest（最新正式版）
# 建议固定版本，升级时改这里，见 README「升级」
# CLOSETLY_VERSION=0.1.0

# 首个管理员账号，仅在数据库中还没有任何用户时生效
CLOSETLY_ADMIN_USERNAME=admin
CLOSETLY_ADMIN_PASSWORD=请改成至少8位的强密码

# 监听地址（宿主机端口）
# CLOSETLY_BIND=127.0.0.1:8000

# 信任哪些地址传来的 X-Forwarded-* 请求头
# FORWARDED_ALLOW_IPS=*

# 仅在本地用 http 调试时设为 false；公网部署必须保持 true
# CLOSETLY_COOKIE_SECURE=true
